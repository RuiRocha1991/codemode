# Copiar para .env (que está no .gitignore) ou exportar na shell.
# Uma API Key por ambiente, de um utilizador de serviço com o mínimo de permissões.

XRAY_LOCAL_CLIENT_ID=
XRAY_LOCAL_CLIENT_SECRET=

XRAY_STAGING_CLIENT_ID=
XRAY_STAGING_CLIENT_SECRET=

# Opcional: sobrepõe o baseUrl do ambiente escolhido (por exemplo a porta do local).
# XRAY_BASE_URL=http://localhost:3001
