{
  "name": "@codemode/gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Gateway Code Mode: liga a servidores MCP normais, gera uma API TypeScript a partir dos esquemas e corre o código do assistente na sandbox do @codemode/core.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": { "codemode-gateway": "dist/main.js" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "engines": { "node": ">=22" },
  "license": "UNLICENSED",
  "dependencies": {
    "@codemode/core": "*",
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  }
}
